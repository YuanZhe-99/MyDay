    <color name="widget_background">#FFF4F2FA</color>
    <color name="widget_on_surface">#FF1B1B21</color>
    <color name="widget_on_surface_variant">#FF45464F</color>
    <color name="widget_outline">#FF767680</color>
    <color name="widget_primary">#FF4355B9</color>
    <color name="widget_primary_container">#FFDEE0FF</color>
    <color name="widget_on_primary_container">#FF00105C</color>
    <color name="widget_on_primary">#FFFFFFFF</color>
    <color name="widget_error">#FFBA1A1A</color>
    <color name="widget_warning">#FF8C5300</color>
    <color name="widget_positive">#FF2E7D32</color>
</resources>
