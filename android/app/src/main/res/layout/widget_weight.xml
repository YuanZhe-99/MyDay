<?xml version="1.0" encoding="utf-8"?>
<!-- Weight widget (2x2): latest weight, 30-day change, BMI, a sparkline bitmap
     drawn by WeightWidgetProvider, and the time of the latest record. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <!-- Header: title and the add button (the status pill on the timer). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_weight_name"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_header_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="+"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_weight_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textColor="@color/widget_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/widget_weight_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="3dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_weight_change"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_weight_bmi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginStart="6dp"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_weight_spark"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/widget_weight_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
